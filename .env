# Oracle Autonomous Database Configuration
# Copy this file to .env and fill in your credentials

# Database connection string from tnsnames.ora
# Options: testdb_high, testdb_low, testdb_medium, testdb_tp, testdb_tpurgent
# DB_CONNECT_STRING=testdb_high
DB_CONNECT_STRING=dtoq263argko9bqg_high


# TNS_ADMIN = /Users/mac/Downloads/Cursor/TESTDB
# TNS_ADMIN=./TESTDB
TNS_ADMIN=./Wallet


ORACLE_CLIENT_LIB_DIR=/Users/mac/oracle/instantclient_23_3

ORACLE_WALLET_PATH=./Wallet

# Database credentials
# DB_USER=DEVELOPER
# DB_PASSWORD=Mango@@2025123

DB_USER=ADMIN
# DB_PASSWORD=Better_2026__
DB_PASSWORD=Simple@@628123


# Connection pool settings (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=1
DB_POOL_TIMEOUT=60

# ORACLE_CLIENT_LIB_DIR=/opt/homebrew/lib

# Face detection performance tuning (TinyFaceDetector)
# Faster balanced profile for this machine.
FACE_DETECTOR_INPUT_SIZE=160
FACE_DETECTOR_SCORE_THRESHOLD=0.5
FACE_MATCH_THRESHOLD=0.65
FACE_IMAGE_MAX_EDGE=480
