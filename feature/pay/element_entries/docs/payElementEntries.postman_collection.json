{
  "info": {
    "name": "Digify ERP — Payroll Element Entries",
    "description": "CRUD APIs for PAY.PAY_ELEMENT_ENTRIES_PKG using ELEMENT_ID (not component_id) and element_entry_guid.\n\nSet {{baseUrl}}, {{jwt}}, and {{element_entry_guid}} in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "jwt", "value": "" },
    { "key": "element_entry_guid", "value": "" }
  ],
  "item": [
    {
      "name": "List Element Entries",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/pay/element-entries?enterprise_id=1&page=1&limit=20&sortBy=creation_date&sortOrder=desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pay", "element-entries"],
          "query": [
            { "key": "enterprise_id", "value": "1" },
            { "key": "employee_id", "value": "292", "disabled": true },
            { "key": "element_id", "value": "1001", "disabled": true },
            { "key": "payroll_id", "value": "4", "disabled": true },
            { "key": "approval_status_code", "value": "DRAFT", "disabled": true },
            { "key": "sortBy", "value": "creation_date" },
            { "key": "sortOrder", "value": "desc" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "Get Element Entry by GUID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/api/pay/element-entries/{{element_entry_guid}}"
      }
    },
    {
      "name": "Create Element Entry",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enterprise_id\": 1,\n  \"employee_id\": 292,\n  \"payroll_id\": 4,\n  \"element_id\": 1001,\n  \"effective_as_of_date\": \"2026-01-01\",\n  \"effective_start_date\": \"2026-01-01\",\n  \"effective_end_date\": null,\n  \"entry_type_code\": \"ELEMENT_ENTRY\",\n  \"source_code\": \"MANUAL_ENTRY\",\n  \"element_classification_code\": \"EARNINGS\",\n  \"element_processing_type_code\": \"RECURRING\",\n  \"pay_value\": 500,\n  \"amount\": 500,\n  \"currency_code\": \"KWD\",\n  \"approval_status_code\": \"DRAFT\",\n  \"cost_allocation_keyflex_id\": \"100\",\n  \"costing_type_code\": \"DEBIT\",\n  \"account_code\": \"5000\",\n  \"cost_center_code\": \"CC100\",\n  \"context_segment_code\": \"PROJECT\",\n  \"context_value\": \"ERP2026\",\n  \"comments\": \"Monthly basic salary\"\n}"
        },
        "url": "{{baseUrl}}/api/pay/element-entries"
      }
    },
    {
      "name": "Update Element Entry",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enterprise_id\": 1,\n  \"employee_id\": 292,\n  \"payroll_id\": 4,\n  \"element_id\": 1001,\n  \"effective_as_of_date\": \"2026-01-01\",\n  \"effective_start_date\": \"2026-01-01\",\n  \"effective_end_date\": null,\n  \"entry_type_code\": \"ELEMENT_ENTRY\",\n  \"source_code\": \"MANUAL_ENTRY\",\n  \"element_classification_code\": \"EARNINGS\",\n  \"element_processing_type_code\": \"RECURRING\",\n  \"pay_value\": 600,\n  \"amount\": 600,\n  \"currency_code\": \"KWD\",\n  \"approval_status_code\": \"DRAFT\",\n  \"cost_allocation_keyflex_id\": \"100\",\n  \"costing_type_code\": \"DEBIT\",\n  \"account_code\": \"5000\",\n  \"cost_center_code\": \"CC100\",\n  \"context_segment_code\": \"PROJECT\",\n  \"context_value\": \"ERP2026\",\n  \"comments\": \"Updated salary\"\n}"
        },
        "url": "{{baseUrl}}/api/pay/element-entries/{{element_entry_guid}}"
      }
    },
    {
      "name": "Delete Element Entry",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/api/pay/element-entries/{{element_entry_guid}}"
      }
    }
  ]
}
