{
  "info": {
    "name": "Digify ERP — Payroll Element Entries",
    "description": "CRUD APIs for PAY.PAY_ELEMENT_ENTRIES_PKG using ELEMENT_ID (not component_id) and element_entry_guid.\n\nSet {{baseUrl}}, {{jwt}}, and {{element_entry_guid}} in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "jwt", "value": "" },
    { "key": "element_entry_guid", "value": "" }
  ],
  "item": [
    {
      "name": "List Element Entries",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/pay/element-entries?enterprise_id=1&page=1&limit=20&sortBy=creation_date&sortOrder=desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pay", "element-entries"],
          "query": [
            { "key": "enterprise_id", "value": "1" },
            { "key": "employee_id", "value": "292", "disabled": true },
            { "key": "element_id", "value": "1001", "disabled": true },
            { "key": "payroll_id", "value": "4", "disabled": true },
            { "key": "approval_status_code", "value": "DRAFT", "disabled": true },
            { "key": "sortBy", "value": "creation_date" },
            { "key": "sortOrder", "value": "desc" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "Export Element Entries (Excel)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/pay/element-entries/export?enterprise_id=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pay", "element-entries", "export"],
          "query": [
            { "key": "enterprise_id", "value": "1" },
            { "key": "employee_id", "value": "292", "disabled": true },
            { "key": "element_id", "value": "1001", "disabled": true },
            { "key": "payroll_id", "value": "4", "disabled": true },
            { "key": "approval_status_code", "value": "DRAFT", "disabled": true },
            { "key": "sortBy", "value": "creation_date", "disabled": true },
            { "key": "sortOrder", "value": "desc", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "Get Element Entry by GUID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/api/pay/element-entries/{{element_entry_guid}}"
      }
    },
    {
      "name": "Create Element Entry",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enterprise_id\": 1,\n  \"employee_id\": 292,\n  \"element_id\": 3,\n  \"effective_as_of_date\": \"2026-07-15\",\n  \"effective_start_date\": \"2026-07-15\"\n}"
        },
        "url": "{{baseUrl}}/api/pay/element-entries"
      }
    },
    {
      "name": "Create Element Entry (with optional fields)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enterprise_id\": 1,\n  \"employee_id\": 292,\n  \"element_id\": 3,\n  \"effective_as_of_date\": \"2026-07-15\",\n  \"effective_start_date\": \"2026-07-15\",\n  \"context_segment_code\": \"OVERTIME_TYPE\",\n  \"context_value\": \"WEEKEND\",\n  \"sub_classification_code\": \"REGULAR_OVERTIME\",\n  \"currency_code\": \"KWD\",\n  \"pay_value\": 125.5,\n  \"amount\": 125.5\n}"
        },
        "url": "{{baseUrl}}/api/pay/element-entries"
      }
    },
    {
      "name": "Update Element Entry (partial amount)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 150\n}"
        },
        "url": "{{baseUrl}}/api/pay/element-entries/{{element_entry_guid}}"
      }
    },
    {
      "name": "Update Element Entry (clear optional fields)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pay_value\": null,\n  \"amount\": null,\n  \"currency_code\": null,\n  \"context_segment_code\": null,\n  \"context_value\": null,\n  \"sub_classification_code\": null\n}"
        },
        "url": "{{baseUrl}}/api/pay/element-entries/{{element_entry_guid}}"
      }
    },
    {
      "name": "Delete Element Entry",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/api/pay/element-entries/{{element_entry_guid}}"
      }
    }
  ]
}
