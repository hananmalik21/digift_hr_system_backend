{
  "info": {
    "name": "DigifyHR Recruiting — Application Match APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Deterministic application-to-requisition match scoring. Canonical paths use /api/recruitment. /api/recruiting and /api/rec/requisitions aliases are also mounted."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "requisition_guid", "value": "574176DB57C7EFCBE0631718000A61BB" },
    { "key": "application_guid", "value": "APPLICATION_GUID" }
  ],
  "item": [
    {
      "name": "1. List application matches for requisition",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/recruitment/requisitions/{{requisition_guid}}/application-matches?page=1&page_size=20&min_match_score=70&eligibility_status=ELIGIBLE&sort_by=match_score&sort_order=desc"
      }
    },
    {
      "name": "2. Application match detail",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/recruitment/applications/{{application_guid}}/match"
      }
    },
    {
      "name": "3. Recalculate one application",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/recruitment/applications/{{application_guid}}/recalculate-match"
      }
    },
    {
      "name": "4. Recalculate all applications for requisition",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/recruitment/requisitions/{{requisition_guid}}/recalculate-application-matches"
      }
    },
    {
      "name": "5. Application match summary",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/recruitment/requisitions/{{requisition_guid}}/application-match-summary"
      }
    }
  ]
}
