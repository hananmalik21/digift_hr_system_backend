### Variables
@baseUrl = http://localhost:3000
@structureGuid = REPLACE_WITH_32_CHAR_HEX_FROM_CREATE_RESPONSE

### Create salary structure — success
POST {{baseUrl}}/api/comp/salary-structures
Content-Type: application/json

{
  "structure_code": "SAL_STR_001",
  "structure_name": "Monthly Salary Structure",
  "structure_type_code": "MONTHLY",
  "currency_code": "KWD",
  "country_id": 1,
  "enterprise_id": 1,
  "description": "Default monthly salary structure",
  "status": "ACTIVE",
  "active_flag": "Y",
  "effective_from": "2026-01-01",
  "effective_to": null,
  "advanced_settings": {
    "enable_payroll_integration": "Y",
    "auto_calc_components": "Y",
    "enable_version_control": "Y",
    "require_multi_approval": "N",
    "enable_audit_logging": "Y",
    "allow_manual_override": "Y"
  },
  "financial_details": {
    "cost_center_code": "CC-100",
    "effective_from": "2026-01-01",
    "effective_to": null,
    "annual_budget_amount": 500000
  },
  "org_scope": {
    "country_code": "KUWAIT",
    "business_units": [
      "4C7F9CCE1AB49532E0633519000AA722"
    ],
    "employee_categories": [
      "STAFF",
      "MANAGEMENT"
    ]
  },
  "components": [
    {
      "component_id": 41,
      "display_sequence": 1,
      "calculation_method_code": "AMOUNT",
      "default_value": 100,
      "min_value": 100,
      "max_value": 1000,
      "active_flag": "Y"
    }
  ]
}

### Create — validation error (missing components)
POST {{baseUrl}}/api/comp/salary-structures
Content-Type: application/json

{
  "structure_code": "X",
  "structure_name": "Y",
  "effective_from": "2026-01-01",
  "components": []
}

### Update salary structure (partial body)
PUT {{baseUrl}}/api/comp/salary-structures/{{structureGuid}}
Content-Type: application/json

{
  "structure_name": "Updated Monthly Salary Structure",
  "status": "ACTIVE"
}

### Delete salary structure (no body)
DELETE {{baseUrl}}/api/comp/salary-structures/{{structureGuid}}

### Sample success response (delete)
# HTTP/1.1 200 OK
# {
#   "success": true,
#   "message": "Salary structure deleted successfully"
# }

### Sample not found (delete / update when row missing)
# HTTP/1.1 404 Not Found
# {
#   "success": false,
#   "error": "Salary structure not found",
#   "error_code": "404"
# }

### Sample success response (create)
# HTTP/1.1 201 Created
# {
#   "success": true,
#   "data": {
#     "structure_id": 123,
#     "structure_guid": "ABCD1234..."
#   }
# }

### Sample error response (Oracle)
# HTTP/1.1 500 Internal Server Error
# {
#   "success": false,
#   "error": "ORA-20001: ...",
#   "error_code": "20001"
# }
